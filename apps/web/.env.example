# Supabase (ku_suporters). 두 값이 모두 있으면 DB·Storage를 쓰고, 없으면 메모리 데모 모드
SUPABASE_URL=https://ctfrczbxfveozvplprnr.supabase.co
# Supabase 대시보드 > Project Settings > API Keys > Secret keys (sb_secret_...). 절대 저장소·채팅에 올리지 말 것
SUPABASE_SECRET_KEY=
# 공개 주소 (예약 게시 시 인스타 서버가 영상을 가져갈 https 주소). 로컬에서는 비워 두면 데모 게시로 동작
PUBLIC_BASE_URL=
# 인스타그램 (docs/INSTAGRAM_SETUP.md 참고)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/instagram/callback
# Claude API (선택, 권장). 넣으면 공고 분석·지원서 뼈대·후기 분석이 실제 AI로 동작. 절대 저장소·채팅에 올리지 말 것
# https://platform.claude.com 에서 발급. 비우면 아래 로컬 LLM → 데모 모드 순으로 내려감
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Google Gemini API (선택). Claude 키가 없으면 이걸 씀. https://aistudio.google.com/apikey 에서 무료로 발급 (카드 없이 가능)
# 절대 저장소·채팅에 올리지 말 것. 모델은 비우면 gemini-flash-latest (구글이 최신 Flash로 바꿔 주는 별칭)
GEMINI_API_KEY=
GEMINI_MODEL=
# 생각 깊이 (비우면 low). 느리면 minimal, 답이 얕으면 medium
GEMINI_THINKING=
# 첫 모델이 붐빌 때(503 · 답 없음) 차례로 쓸 모델. 쉼표로 여러 개. 비우면 gemini-flash-lite-latest
GEMINI_FALLBACK_MODELS=
# 로컬 LLM (선택). Claude·Gemini 키가 없을 때만 씀. Gemma 등 로컬 모델로 보강 작업을 처리 (0 크레딧)
OLLAMA_URL=
OLLAMA_MODEL=gemma4:e4b
# 문맥 길이(토큰). 기본 16384. 메모리가 부족해 느리거나 멈추면 8192로 낮추기
OLLAMA_NUM_CTX=
# 이미지를 읽지 못하는 로컬 모델이면 0 (공고 포스터는 tesseract로 읽음). Gemma 4는 이미지를 읽어요
OLLAMA_VISION=
# 자막 글꼴 경로 (서버). 비우면 흔한 경로에서 찾음
CAPTION_FONT_FILE=
# 로그인 쿠키 서명용 비밀값 (배포에서는 꼭 넣기, 32자 이상 아무 문자열). 바꾸면 모두 로그아웃됨
# 만들기: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# 주기 작업 보호용 비밀값 (/api/cron/publish 호출 시 ?key=)
CRON_SECRET=

# 권한: 로그인 아이디를 쉼표로 (예: chaeryeong,teammate1)
# ADMIN_LOGIN_IDS: /admin 합격 경험 검수·크레딧 지급 (팀 권한도 함께 받음)
# TEAM_LOGIN_IDS : /reviews 후기 분석 입력·검수·CSV 내려받기
# 비워 두면 아무도 들어갈 수 없어요
ADMIN_LOGIN_IDS=
TEAM_LOGIN_IDS=
